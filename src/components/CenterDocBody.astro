---
/**
 * Cuerpo de una ficha de documento de centro: los bloques de referencias, el
 * histórico plegado y los descartes.
 *
 * Lo comparten la ficha completa y la página de cada una de sus partes, que no
 * es más que la misma ficha recortada a las referencias de esa parte. Así una
 * parte con nombre propio tiene página propia sin duplicar un solo dato.
 */
import type { Lang, ResolvedCenterDoc } from '../lib/types';
import FreshnessBadge from './FreshnessBadge.astro';
import { t } from '../i18n/utils';

interface Props {
  doc: ResolvedCenterDoc;
  lang: Lang;
  showDiscarded?: boolean;
}

const { doc, lang, showDiscarded = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const lawPath = lang === 'va' ? 'llei' : 'ley';

const visibles = doc.groups.filter(g => g.id !== 'historico');
const historico = doc.groups.find(g => g.id === 'historico');
---

<main>
      {visibles.map(group => (
        <section class="doc-group">
          <h2 class="group-title">{t(`docs.group.${group.id}`, lang)}</h2>
          <p class="group-desc">{t(`docs.group.${group.id}_desc`, lang)}</p>

          {group.laws.map(law => (
            <section class="law-group">
              <h3 class="law-heading">
                <a href={`${base}${lang}/${lawPath}/${law.lawSlug}/`}>{law.lawShort}</a>
                {law.schoolYear && (
                  <span class="law-course">{t('docs.course', lang, { year: law.schoolYear })}</span>
                )}
              </h3>
              <p class="law-full-title">{law.lawTitle}</p>

              {law.fragments.map(f => (
                <article class="fragment-block">
                  <h4 class="fragment-title">
                    <a href={f.url}>{f.articleTitle}</a>
                    {f.apartado && (
                      <span class="fragment-apartado">{t('cuadernos.apartado', lang, { path: f.apartado })}</span>
                    )}
                  </h4>
                  <FreshnessBadge freshness={f.freshness} lang={lang} checkedAt={f.savedAt} />
                  <div class="fragment-body" set:html={f.html} />
                </article>
              ))}
            </section>
          ))}
        </section>
      ))}

      {historico && (
        <details class="historico">
          <summary>{t('docs.historico_toggle', lang)}</summary>
          <p class="group-desc">{t('docs.group.historico_desc', lang)}</p>
          {historico.laws.map(law => (
            <section class="law-group">
              <h3 class="law-heading">
                <a href={`${base}${lang}/${lawPath}/${law.lawSlug}/`}>{law.lawShort}</a>
                {law.schoolYear && (
                  <span class="law-course">{t('docs.course', lang, { year: law.schoolYear })}</span>
                )}
              </h3>
              <p class="law-full-title">{law.lawTitle}</p>
              {law.fragments.map(f => (
                <article class="fragment-block">
                  <h4 class="fragment-title">
                    <a href={f.url}>{f.articleTitle}</a>
                    {f.apartado && (
                      <span class="fragment-apartado">{t('cuadernos.apartado', lang, { path: f.apartado })}</span>
                    )}
                  </h4>
                  <div class="fragment-body" set:html={f.html} />
                </article>
              ))}
            </section>
          ))}
        </details>
      )}
      {showDiscarded && doc.discarded.length > 0 && (
        <details class="descartes">
          <summary>
            {t('docs.discarded_toggle', lang, {
              count: String(doc.discarded.reduce((n, g) => n + g.items.length, 0)),
            })}
          </summary>
          <p class="group-desc">{t('docs.discarded_intro', lang)}</p>
          {doc.discarded.map(group => (
            <section class="descarte-law">
              <h3 class="descarte-law-title">{group.lawShort}</h3>
              <ul class="descarte-list">
                {group.items.map(item => (
                  <li class="descarte">
                    <p class="descarte-head">
                      {item.url ? (
                        <a href={item.url}>
                          {item.articleId === '*'
                            ? t('docs.discarded_whole', lang)
                            : item.articleTitle}
                        </a>
                      ) : (
                        <span>{item.articleTitle}</span>
                      )}
                      {item.apartado && (
                        <span class="fragment-apartado">{t('cuadernos.apartado', lang, { path: item.apartado })}</span>
                      )}
                      {item.count && (
                        <span class="fragment-apartado">{t('docs.discarded_count', lang, { count: String(item.count) })}</span>
                      )}
                    </p>
                    <p class="descarte-reason">{item.reason}</p>
                    {item.preview && <p class="descarte-preview">{item.preview}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </details>
      )}

</main>

<style>
  .detail-page {
    max-width: 52rem;
    padding-bottom: var(--space-2xl);
  }

  .back-link {
    display: inline-block;
    margin: var(--space-lg) 0;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover { color: var(--color-primary); }

  .doc-header {
    padding-bottom: var(--space-lg);
    border-bottom: 2px solid var(--color-border);
    margin-bottom: var(--space-xl);
  }

  .doc-short {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }

  .doc-header h1 {
    font-size: 1.9rem;
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .doc-desc {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .doc-meta,
  .doc-scope {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .doc-stale {
    margin-bottom: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    border-left: 3px solid #8f5511;
    background: #fdf6ec;
    color: #8f5511;
    font-size: 0.9rem;
  }

  .doc-group { margin-bottom: var(--space-2xl); }

  .group-title {
    font-size: 1.3rem;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .group-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: var(--space-lg);
  }

  .law-group { margin-bottom: var(--space-xl); }

  .law-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0;
  }

  .law-heading a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .law-heading a:hover { color: var(--color-primary); }

  .law-course {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }

  .law-full-title {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: var(--space-xs) 0 var(--space-md);
  }

  .fragment-block {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-border);
  }

  .fragment-title {
    font-size: 0.95rem;
    margin-bottom: var(--space-xs);
  }

  .fragment-title a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .fragment-title a:hover { text-decoration: underline; }

  .fragment-apartado {
    margin-left: var(--space-xs);
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .fragment-body {
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .descartes {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .descartes summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .descartes summary:hover { color: var(--color-primary); }

  .descarte-law { margin-bottom: var(--space-lg); }

  .descarte-law-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-sm);
  }

  .descarte-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .descarte {
    padding-left: var(--space-md);
    border-left: 2px dashed var(--color-border);
  }

  .descarte-head {
    margin: 0;
    font-size: 0.9rem;
  }

  .descarte-head a { color: var(--color-primary); text-decoration: none; }
  .descarte-head a:hover { text-decoration: underline; }

  .descarte-reason {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .descarte-preview {
    margin: 0.3rem 0 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .historico {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-lg);
  }

  .historico summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .historico summary:hover { color: var(--color-primary); }
</style>
